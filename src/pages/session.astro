---
import { Picture } from "astro:assets";
import backgroundImage from "@/assets/images/session-board/red-wave-background.png";
import SessionBoard from "@/components/SessionBoard/SessionBoard.vue";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Session Board - Atelier">
  <SessionBoard client:only="vue">
    <Picture
      slot="background"
      src={backgroundImage}
      formats={["avif", "webp"]}
      widths={[640, 750, 828, 1080, 1200, 1920, 2048, 3840]}
      quality="high"
      alt=""
      aria-hidden
    />
  </SessionBoard>
</Layout>

<style lang="scss">
  @use "inter-ui/variable" with (
    $inter-font-display: swap,
    $inter-font-path: "inter-ui/variable"
  );

  @include variable.all;

  body {
    font-family: "InterVariable", "system-ui";
  }
</style>
